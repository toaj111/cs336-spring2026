{
    "experiment_name": "baseline",
    "experiments_dir": "cs336_basics/experiments",
    "vocab_size": 10000,
    "context_length": 256,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 16,
    "d_ff": 1344,
    "rope_theta": 10000,
    "device": "cuda:0",
    "dtype": null,
    "use_rope": true,
    "use_rms_norm": true,
    "use_pre_norm": true,
    "use_swiglu": true,
    "training_data_path": "cs336_basics/data/test_train.npy",
    "valid_data_path": "cs336_basics/data/test_valid.npy",
    "batch_size": 64,
    "eval_batches": 10,
    "max_iters": 20000,
    "max_checkpoints": 5,
    "checkpoints_dir": "checkpoints",
    "optimizer": "adamw",
    "lr": 0.001,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "eps": 1e-08,
    "lr_strategy": "cosine_lr_schedule_with_warmup",
    "logging_interval": 100,
    "eval_interval": 200,
    "save_interval": 1000
}
